{
  "$schema": "https://json.schemastore.org/claude-code-settings",
  "language": "japanese",
  "autoMemoryEnabled": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-after-edit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "plan",
    "ask": [
      "Bash(pnpm install *)",
      "Bash(git push *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  }
}
